    },
    "Your result is kept in history. Videos aren’t uploaded to your account; older sessions may only have a saved result." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Ergebnis bleibt im Verlauf. Videos werden nicht in dein Konto hochgeladen; bei älteren Trainings ist eventuell nur das Ergebnis gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu resultado se queda en el historial. Los videos no se suben a tu cuenta; de las sesiones antiguas puede que solo quede el resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton résultat reste dans l’historique. Les vidéos ne sont pas envoyées sur ton compte ; pour les anciennes séances, seul le résultat est parfois conservé."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu resultado fica no histórico. Os vídeos não vão para sua conta; treinos mais antigos podem ter só o resultado salvo."
          }
        }
      }
    },
    "Your result is saved, but the replay couldn’t be kept. Check the free space on your phone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

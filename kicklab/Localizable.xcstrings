    "Annotated video ready — share it from the menu" : {
      "comment" : "Debug, lab or unused screen; not shown in release builds.",
      "shouldTranslate" : false
    },
    "Another video is finishing its ball effects. Please try again shortly." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Video bekommt gerade seine Balleffekte. Versuch es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro video está terminando sus efectos de balón. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre vidéo termine ses effets de ballon. Réessaie dans un instant."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro vídeo está terminando os efeitos de bola. Tente de novo daqui a pouco."
          }
        }
      }
    },
    "Any correction it made is removed immediately and your device-counted streak counts again. The clips are queued for deletion within 24 hours. Your recording stays on your phone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Korrektur dadurch wird sofort entfernt und deine vom Gerät gezählte Serie zählt wieder. Die Clips werden innerhalb von 24 Stunden gelöscht. Deine Aufnahme bleibt auf deinem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier corrección se quita al momento y vuelve a contar la racha contada por tu dispositivo. Los clips se borrarán en un plazo de 24 horas. Tu grabación se queda en tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute correction est retirée immédiatement et la série comptée par ton appareil compte à nouveau. Les clips seront supprimés sous 24 heures. Ta vidéo reste sur ton téléphone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer correção é removida na hora e a sequência contada pelo seu aparelho volta a valer. Os clipes serão apagados em até 24 horas. Sua gravação fica no seu celular."
          }
        }
      }
    },
    "App memory: %.1f MiB\nPeak: %.1f MiB\nBall masks: %.2f / 64 MiB" : {

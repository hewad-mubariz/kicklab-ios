            "value" : "Suas gravações ficam no seu iPhone."
          }
        }
      }
    },
    "Your recordings stay on your phone. Only each session’s touch count, best streak, length and date reach your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufnahmen bleiben auf deinem iPhone. In dein Konto kommen nur Kontaktzahl, beste Serie, Dauer und Datum jedes Trainings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grabaciones se quedan en tu teléfono. A tu cuenta solo llegan los toques, la mejor racha, la duración y la fecha de cada sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes vidéos restent sur ton téléphone. Seuls le nombre de jongles, la meilleure série, la durée et la date de chaque séance arrivent sur ton compte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas gravações ficam no seu celular. Só o número de toques, a melhor sequência, a duração e a data de cada treino vão para sua conta."
          }
        }
      }
    },
    "Your recordings stay on your phone. Session results and basic session details sync to your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufnahmen bleiben auf deinem iPhone. Trainingsergebnisse und grundlegende Trainingsdaten werden mit deinem Konto synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grabaciones se quedan en tu iPhone. Los resultados y los datos básicos de las sesiones se sincronizan con tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes enregistrements restent sur ton iPhone. Les résultats et les informations de base des séances sont synchronisés avec ton compte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas gravações ficam no seu iPhone. Os resultados e os dados básicos dos treinos são sincronizados com sua conta."
          }
        }
      }
    },
    "Your replay is ready" : {

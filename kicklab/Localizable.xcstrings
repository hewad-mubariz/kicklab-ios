    "You asked for %lld. Your streak of %lld counts until then." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$lld angefragt. Bis dahin zählt deine Serie von %2$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pediste %1$lld. Hasta entonces cuenta tu racha de %2$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as demandé %1$lld. D’ici là, ta série de %2$lld compte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

    "If the connection drops, it carries on by itself when you’re back online." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bricht die Verbindung ab, geht es automatisch weiter, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se corta la conexión, sigue sola cuando vuelvas a tener conexión."

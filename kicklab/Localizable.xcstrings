          }
        }
      }
    },
    "There are no prizes, paid score advantages or trick bonuses. You can train without joining." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Preise, bezahlten Punktevorteile oder Trickboni. Du kannst auch ohne Teilnahme trainieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay premios, ventajas de puntuación de pago ni puntos extra por trucos. Puedes entrenar sin unirte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a ni prix, ni avantages de score payants, ni bonus pour les figures. Tu peux t’entraîner sans participer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há prêmios, vantagens pagas na pontuação nem bônus por truques. Você pode treinar sem participar."
          }
        }
      }
    },
    "There isn’t enough free storage to safely save this video. Free some space and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist nicht genug Speicher frei, um dieses Video sicher zu speichern. Schaff etwas Platz und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay espacio suficiente para guardar este video con seguridad. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas assez d’espace libre pour enregistrer cette vidéo en toute sécurité. Libère de l’espace et réessaie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

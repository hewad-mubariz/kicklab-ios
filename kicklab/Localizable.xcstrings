    "You’re offline. Connect to the internet and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Verbinde dich mit dem Internet und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión. Conéctate a internet e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es hors ligne. Connecte-toi à Internet et réessaie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está offline. Conecte-se à internet e tente de novo."
          }
        }
      }
    },
    "You’re offline. Connect to the internet to delete your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

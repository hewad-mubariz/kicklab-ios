    "Frame your shot and tap Record. Choose your effects after." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte deinen Schuss aus und tippe auf „Aufnehmen“. Die Effekte wählst du danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuadra tu disparo y toca Grabar. Los efectos, después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadre ta frappe et touche Filmer. Tu choisiras les effets après."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquadre seu chute e toque em Gravar. Os efeitos vêm depois."
          }
        }
      }
    },

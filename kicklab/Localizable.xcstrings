    "Join the leaderboard and record while signed in. Your best streak appears after syncing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tritt der Rangliste bei und nimm angemeldet ein Training auf. Deine beste Serie erscheint nach der Synchronisierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Únete al ranking y graba con la sesión iniciada. Tu mejor racha aparece al sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoins le classement et enregistre une séance en étant connecté. Ta meilleure série apparaît après la synchronisation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre no ranking e grave com sua conta conectada. Sua melhor sequência aparece após a sincronização."
          }
        }
      }
    },
    "Join the leaderboard?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Rangliste mitmachen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Unirte al ranking?"
          }
        },
        "fr" : {

    },
    "This result could not sync. It is kept on this phone; contact support if you need help." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Ergebnis konnte nicht synchronisiert werden. Es bleibt auf diesem iPhone. Melde dich beim Support, wenn du Hilfe brauchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este resultado no se pudo sincronizar. Se queda en este teléfono; contacta con soporte si necesitas ayuda."

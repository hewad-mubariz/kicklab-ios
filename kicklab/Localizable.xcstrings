    "Apple" : {
      "comment" : "Debug, lab or unused screen; not shown in release builds.",
      "shouldTranslate" : false
    },
    "Apple access verified until %@" : {
      "comment" : "Debug, lab or unused screen; not shown in release builds.",
      "shouldTranslate" : false
    },
    "Apple account deletion is temporarily unavailable. Your account has not been deleted. Please try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen über Apple ist gerade nicht möglich. Dein Konto wurde nicht gelöscht. Bitte versuch es später noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eliminación con Apple no está disponible por ahora. Tu cuenta no se eliminó. Inténtalo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression via Apple est momentanément indisponible. Ton compte n’a pas été supprimé. Réessaie plus tard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exclusão pela Apple está indisponível no momento. Sua conta não foi excluída. Tente mais tarde."
          }
        }
      }
    },
    "Apple confirmation couldn’t be completed. Please try deleting your account again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bestätigung durch Apple konnte nicht abgeschlossen werden. Bitte versuch noch einmal, dein Konto zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar la confirmación con Apple. Intenta eliminar tu cuenta de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La confirmation Apple n’a pas abouti. Réessaie de supprimer ton compte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível concluir a confirmação da Apple. Tente excluir sua conta de novo."
          }
        }
      }
    },
    "Apple confirmed the transaction, but an active subscription isn’t available yet. Please try Restore purchases." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple hat die Transaktion bestätigt, aber noch ist kein aktives Abo verfügbar. Tippe bitte auf „Käufe wiederherstellen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple confirmó la transacción, pero aún no hay una suscripción activa. Prueba Restaurar compras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple a confirmé la transaction, mais aucun abonnement actif n’est encore disponible. Essaie « Restaurer les achats »."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple confirmou a transação, mas ainda não há uma assinatura ativa. Tente Restaurar compras."
          }
        }
      }
    },
    "Apple could not complete sign-in. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple konnte die Anmeldung nicht abschließen. Bitte versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple no pudo completar el inicio de sesión. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n’a pas pu finaliser la connexion. Réessaie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple não conseguiu concluir o login. Tente de novo."
          }
        }
      }
    },
    "Apple couldn’t refresh your purchase history. Check your connection and the Apple Account used to subscribe, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple konnte deinen Kaufverlauf nicht aktualisieren. Prüf deine Verbindung und den Apple Account, mit dem du abonniert hast, und versuch es dann noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple no pudo actualizar tu historial de compras. Revisa tu conexión y la cuenta de Apple con la que te suscribiste, e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n’a pas pu actualiser ton historique d’achats. Vérifie ta connexion et le compte Apple utilisé pour l’abonnement, puis réessaie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple não conseguiu atualizar seu histórico de compras. Verifique sua conexão e a Conta Apple usada na assinatura e tente de novo."
          }
        }
      }
    },
    "Apple couldn’t verify this purchase. Try Restore purchases, or contact Apple Support if the charge appears in your purchase history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple konnte diesen Kauf nicht bestätigen. Versuch „Käufe wiederherstellen“ oder wende dich an den Apple Support, wenn die Abbuchung in deinem Kaufverlauf steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple no pudo verificar esta compra. Prueba Restaurar compras o contacta con el soporte de Apple si el cargo aparece en tu historial de compras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple n’a pas pu vérifier cet achat. Essaie « Restaurer les achats » ou contacte l’assistance Apple si le paiement apparaît dans ton historique d’achats."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple não conseguiu verificar esta compra. Tente Restaurar compras ou fale com o Suporte da Apple se a cobrança aparecer no seu histórico de compras."
          }
        }
      }
    },
    "Apple is processing this purchase. Pro will activate automatically when it’s approved. You can keep using the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple bearbeitet diesen Kauf. Pro wird automatisch aktiviert, sobald er genehmigt ist. Du kannst die App weiter nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

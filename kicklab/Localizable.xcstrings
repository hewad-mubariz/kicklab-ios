          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión. Conéctate a internet para eliminar tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es hors ligne. Connecte-toi à Internet pour supprimer ton compte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está offline. Conecte-se à internet para excluir sua conta."
          }
        }
      }
    },
    "You’re offline. It sends by itself when you’re back online. You can close this screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Sie wird automatisch gesendet, sobald du wieder online bist. Du kannst diesen Bildschirm schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión. Se enviará sola cuando vuelvas a tenerla. Puedes cerrar esta pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es hors ligne. L’envoi partira tout seul dès que tu seras de nouveau en ligne. Tu peux fermer cet écran."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está offline. Ela é enviada sozinha quando você voltar a ficar online. Você pode fechar esta tela."
          }
        }
      }
    },

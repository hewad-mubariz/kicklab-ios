    "Drag to move the strike; the moves on it come along. Double-tap to go back to the found strike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um den Schuss zu verschieben – die Bewegungen darauf wandern mit. Doppeltippen springt zum erkannten Schuss zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para mover el golpeo; sus movimientos van con él. Toca dos veces para volver al golpeo detectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais glisser pour déplacer la frappe ; ses mouvements suivent. Touche deux fois pour revenir à la frappe détectée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para mover o chute; os movimentos nele vão junto. Toque duas vezes para voltar ao chute detectado."
          }
        }
      }
    },

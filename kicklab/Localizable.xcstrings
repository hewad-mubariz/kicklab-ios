      }
    },
    "You’re #8 of 2,418" : {
      "comment" : "Debug, lab or unused screen; not shown in release builds.",
      "shouldTranslate" : false
    },
    "You’re asked once before you join. Other players see your profile name, photo and best streak, and you can hide them any time in Profile. Gallery imports and guest sessions never rank." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir fragen dich einmal, bevor du mitmachst. Andere Spieler sehen deinen Profilnamen, dein Foto und deine beste Serie. Im Profil kannst du das jederzeit ausblenden. Importe aus der Galerie und Gast-Trainings werden nie gewertet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te lo preguntamos una vez antes de unirte. Otros jugadores ven tu nombre de perfil, tu foto y tu mejor racha, y puedes ocultarlos cuando quieras en Perfil. Los videos importados y las sesiones como invitado nunca entran en el ranking."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On te pose la question une seule fois avant de rejoindre le classement. Les autres joueurs voient ton nom de profil, ta photo et ta meilleure série, et tu peux les masquer à tout moment dans Profil. Les imports de la galerie et les séances en mode invité ne sont jamais classés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntamos uma vez antes de você entrar. Outros jogadores veem seu nome de perfil, sua foto e sua melhor sequência, e você pode ocultar isso quando quiser no Perfil. Vídeos importados e treinos como convidado nunca entram no ranking."
          }
        }
      }
    },
    "You’re hidden from the board. Turn on leaderboard visibility in Profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist in der Rangliste ausgeblendet. Schalte die Sichtbarkeit im Profil ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No apareces en el ranking. Activa la visibilidad en Perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu n’apparais pas au classement. Active la visibilité dans Profil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não aparece no ranking. Ative a visibilidade no Perfil."
          }
        }
      }
    },
    "You’re in" : {
      "localizations" : {
        "de" : {

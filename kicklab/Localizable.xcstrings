    "Watch your saved recordings with the roll cutoffs switched off for this replay. The distance updates from saved ball positions; no new recording is needed." : {
      "comment" : "Debug, lab or unused screen; not shown in release builds.",
      "shouldTranslate" : false
    },
    "We couldn’t follow the ball in this shot. Keep the whole flight in view." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten dem Ball in diesem Schuss nicht folgen. Halte die ganze Flugbahn im Bild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos seguir el balón en este disparo. Mantén toda la trayectoria a la vista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de suivre le ballon sur cette frappe. Garde toute la trajectoire dans le cadre."

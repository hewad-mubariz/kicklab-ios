      }
    },
    "You lead this week" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du führst diese Woche"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vas primero esta semana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mènes cette semaine"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você lidera esta semana"
          }
        }
      }
    },
    "You make 30 touches and the counter isn’t sure of 3 of them, so that run counts 27. Then you stop the ball with your hand and juggle 20 more. Your score is 27, your longest run, not the 50 in all." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du machst 30 Kontakte, bei 3 ist sich der Zähler nicht sicher – diese Serie zählt also 27. Dann stoppst du den Ball mit der Hand und jonglierst noch 20. Dein Ergebnis ist 27, deine längste Serie, nicht die 50 insgesamt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haces 30 toques y el contador duda de 3, así que esa racha cuenta 27. Luego paras el balón con la mano y haces 20 más. Tu puntuación es 27, tu racha más larga, no los 50 en total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu fais 30 jongles et le compteur n’est pas sûr de 3 d’entre eux : cette série compte donc 27. Puis tu arrêtes le ballon avec la main et tu en enchaînes 20 de plus. Ton score est 27, ta plus longue série, pas les 50 au total."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você faz 30 toques e o contador não tem certeza de 3, então essa sequência vale 27. Depois você segura a bola com a mão e faz mais 20. Sua pontuação é 27, sua maior sequência, não os 50 no total."
          }
        }
      }
    },
    "You withdrew this check. Your streak stays at %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diese Prüfung zurückgezogen. Deine Serie bleibt bei %lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retiraste esta revisión. Tu racha se queda en %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as retiré cette vérification. Ta série reste à %lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você retirou esta verificação. Sua sequência continua em %lld."
          }
        }
      }
    },

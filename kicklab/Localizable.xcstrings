    "It sends by itself once this session has synced to your account. You can close this screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird automatisch gesendet, sobald das Training mit deinem Konto synchronisiert ist. Du kannst diesen Bildschirm schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía sola cuando esta sesión se sincronice con tu cuenta. Puedes cerrar esta pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi partira tout seul une fois la séance synchronisée avec ton compte. Tu peux fermer cet écran."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela é enviada sozinha quando este treino sincronizar com sua conta. Você pode fechar esta tela."
          }
        }
      }
    },
    "It sends by itself once you’re online." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird automatisch gesendet, sobald du online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se envía sola cuando tengas conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle partira toute seule dès que tu seras en ligne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela é enviada sozinha quando você estiver online."
          }
        }
      }
    },
    "It sends by itself when you’re back online." : {

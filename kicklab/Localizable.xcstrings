    },
    "Your Juggle Dude Pro subscription is active." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Juggle Dude Pro-Abo ist aktiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu suscripción a Juggle Dude Pro está activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton abonnement Juggle Dude Pro est actif."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua assinatura do Juggle Dude Pro está ativa."
          }
        }
      }
    },
    "Your Pro access is still active. Apple couldn’t refresh your purchase history. You can keep using Pro and try Restore again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Pro-Zugang ist weiterhin aktiv. Apple konnte deinen Kaufverlauf nicht aktualisieren. Du kannst Pro weiter nutzen und später erneut wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu acceso Pro sigue activo. Apple no pudo actualizar tu historial de compras. Puedes seguir usando Pro y volver a restaurar más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton accès Pro est toujours actif. Apple n’a pas pu actualiser ton historique d’achats. Tu peux continuer à utiliser Pro et relancer la restauration plus tard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu acesso Pro continua ativo. A Apple não conseguiu atualizar seu histórico de compras. Você pode continuar usando o Pro e tentar restaurar mais tarde."
          }
        }
      }
    },
    "Your Pro subscription is active on this Apple Account. Manage your plan or cancel through Apple." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Pro-Abo ist mit diesem Apple Account aktiv. Tarif verwalten oder kündigen kannst du über Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu suscripción Pro está activa en esta cuenta de Apple. Gestiona tu plan o cancélalo a través de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton abonnement Pro est actif sur ce compte Apple. Gère ta formule ou résilie via Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua assinatura Pro está ativa nesta Conta Apple. Gerencie seu plano ou cancele pela Apple."
          }
        }
      }
    },
    "Your account updates automatically when you’re connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto wird automatisch aktualisiert, sobald du online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta se actualiza sola cuando tienes conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte se met à jour automatiquement dès que la connexion revient."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta é atualizada sozinha quando houver conexão."
          }
        }
      }
    },
    "Your account was deleted. Some local replays couldn’t be removed. Reopen the app to retry; if they remain, remove the app to clear its local data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto wurde gelöscht. Einige lokale Replays konnten nicht entfernt werden. Öffne die App erneut, um es nochmal zu versuchen. Bleiben sie, lösch die App, um ihre lokalen Daten zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta se eliminó. Algunas repeticiones locales no se pudieron borrar. Vuelve a abrir la app para reintentarlo; si siguen ahí, elimina la app para borrar sus datos locales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte a été supprimé. Certains replays locaux n’ont pas pu être effacés. Rouvre l’app pour réessayer ; s’ils restent, supprime l’app pour effacer ses données locales."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta foi excluída. Alguns replays locais não puderam ser removidos. Abra o app de novo para tentar outra vez; se continuarem, apague o app para limpar os dados locais."
          }
        }
      }
    },
    "Your best recorded streak appears after syncing. Other players see your name, %@, country, photo and streak stats. You can hide your entry any time in Profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine beste aufgenommene Serie erscheint nach der Synchronisierung. Andere Spieler sehen deinen Namen, %@, dein Land, dein Foto und deine Serienstatistik. Du kannst deinen Eintrag jederzeit im Profil ausblenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mejor racha grabada aparece al sincronizar. Otros jugadores ven tu nombre, %@, país, foto y estadísticas de la racha. Puedes ocultar tu entrada cuando quieras en Perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta meilleure série enregistrée apparaît après la synchronisation. Les autres joueurs voient ton nom, %@, ton pays, ta photo et les statistiques de ta série. Tu peux masquer ton entrée à tout moment dans Profil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua melhor sequência gravada aparece após a sincronização. Outros jogadores veem seu nome, %@, país, foto e estatísticas da sequência. Você pode ocultar sua posição a qualquer momento em Perfil."
          }
        }
      }
    },
    "Your best streak" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine beste Serie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mejor racha"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta meilleure série"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua melhor sequência"
          }
        }
      }
    },
    "Your best streak counts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine beste Serie zählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta tu mejor racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta meilleure série compte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a sua melhor sequência."
          }
        }
      }
    },
    "Your best streak ranks by itself after each recorded session. Other players see your name, %@, with your photo and best streak. You can hide them any time in Profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine beste Serie wird nach jedem aufgenommenen Training automatisch gewertet. Andere Spieler sehen deinen Namen, %@, mit Foto und bester Serie. Im Profil kannst du das jederzeit ausblenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mejor racha entra sola en el ranking después de cada sesión grabada. Otros jugadores ven tu nombre, %@, con tu foto y tu mejor racha. Puedes ocultarlos cuando quieras en Perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta meilleure série est classée automatiquement après chaque séance enregistrée. Les autres joueurs voient ton nom, %@, avec ta photo et ta meilleure série. Tu peux les masquer à tout moment dans Profil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua melhor sequência entra no ranking sozinha depois de cada treino gravado. Outros jogadores veem seu nome, %@, com sua foto e melhor sequência. Você pode ocultar isso quando quiser no Perfil."
          }
        }
      }
    },
    "Your best streak ranks by itself after each recorded session. Send touches the counter left out only if you think they were valid." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine beste Serie wird nach jedem aufgenommenen Training automatisch gewertet. Sende weggelassene Kontakte nur, wenn du sie für gültig hältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mejor racha entra sola en el ranking después de cada sesión grabada. Envía los toques que dejó fuera el contador solo si crees que eran válidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta meilleure série est classée automatiquement après chaque séance enregistrée. N’envoie les jongles écartés que si tu penses qu’ils étaient valables."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua melhor sequência entra no ranking sozinha depois de cada treino gravado. Envie os toques que o contador deixou de fora só se achar que valeram."
          }
        }
      }
    },
    "Your check for %lld isn’t sent yet." : {
      "localizations" : {
        "de" : {

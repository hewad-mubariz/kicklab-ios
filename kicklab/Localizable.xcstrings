    "A video task was interrupted when the app closed. Check Photos for a saved export. If it is missing, reopen your original video and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Videoaufgabe wurde beim Schließen der App unterbrochen. Schau in Fotos nach dem Export. Fehlt er, öffne dein Originalvideo erneut und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tarea de video se interrumpió al cerrarse la app. Busca la exportación en Fotos. Si no está, vuelve a abrir tu video original e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une tâche vidéo a été interrompue à la fermeture de l’app. Vérifie dans Photos si l’export est là. Sinon, rouvre ta vidéo d’origine et réessaie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma tarefa de vídeo foi interrompida quando o app fechou. Procure a exportação no app Fotos. Se não estiver lá, abra o vídeo original de novo e tente outra vez."
          }
        }
      }
    },

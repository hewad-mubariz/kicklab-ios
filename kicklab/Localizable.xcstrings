    "Step back until your whole body and the ball fit in the preview. Leave space above your head and around your feet for the ball to move." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh so weit zurück, bis du und der Ball komplett im Bild seid. Lass über dem Kopf und um die Füße herum Platz für den Ball."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aléjate hasta que tu cuerpo entero y el balón entren en la imagen. Deja espacio sobre la cabeza y alrededor de los pies para que se mueva el balón."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recule jusqu’à ce que tout ton corps et le ballon tiennent dans l’image. Laisse de la place au-dessus de ta tête et autour de tes pieds pour le ballon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afaste-se até seu corpo inteiro e a bola caberem na imagem. Deixe espaço acima da cabeça e em volta dos pés para a bola se mexer."
          }
        }
      }
    },

    "What ends a streak" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was eine Serie beendet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué termina una racha"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui arrête une série"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que encerra uma sequência"
          }
        }
      }
    },
    "When hands are hidden, the body is unclear or the ball is lost for a moment, the counter leaves that touch out. It doesn’t count, and it doesn’t end your streak either." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind die Hände verdeckt, ist der Körper unklar oder der Ball kurz weg, lässt der Zähler diesen Kontakt weg. Er zählt nicht, beendet deine Serie aber auch nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si las manos no se ven, el cuerpo no está claro o el balón se pierde un momento, el contador deja fuera ese toque. No cuenta, pero tampoco corta tu racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les mains sont cachées, si le corps n’est pas net ou si le ballon disparaît un instant, le compteur écarte ce jongle. Il ne compte pas, mais n’arrête pas non plus ta série."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando as mãos ficam escondidas, o corpo não aparece bem ou a bola some por um instante, o contador deixa esse toque de fora. Ele não conta, mas também não encerra sua sequência."
          }
        }
      }
    },

    "%@ billed monthly to your Apple Account. Renews automatically unless cancelled at least 24 hours before the end of the current period. Manage or cancel any time in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ monatlich über deinen Apple Account. Verlängert sich automatisch, wenn du nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums kündigst. Verwalten oder kündigen kannst du jederzeit in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al mes, cobrado en tu cuenta de Apple. Se renueva automáticamente salvo que lo canceles al menos 24 horas antes de que termine el periodo actual. Puedes gestionarlo o cancelarlo cuando quieras en la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ facturé chaque mois sur ton compte Apple. Renouvellement automatique sauf résiliation au moins 24 heures avant la fin de la période en cours. Gère ou résilie à tout moment dans Réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cobrado mensalmente na sua Conta Apple. A renovação é automática, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele quando quiser nos Ajustes."
          }
        }
      }
    },
    "%@ billed yearly to your Apple Account. Renews automatically unless cancelled at least 24 hours before the end of the current period. Manage or cancel any time in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jährlich über deinen Apple Account. Verlängert sich automatisch, wenn du nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums kündigst. Verwalten oder kündigen kannst du jederzeit in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al año, cobrado en tu cuenta de Apple. Se renueva automáticamente salvo que lo canceles al menos 24 horas antes de que termine el periodo actual. Puedes gestionarlo o cancelarlo cuando quieras en la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ facturé chaque année sur ton compte Apple. Renouvellement automatique sauf résiliation au moins 24 heures avant la fin de la période en cours. Gère ou résilie à tout moment dans Réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cobrado anualmente na sua Conta Apple. A renovação é automática, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele quando quiser nos Ajustes."

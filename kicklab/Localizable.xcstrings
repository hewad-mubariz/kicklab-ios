    "The video will be removed from this app. Your session result and any copy in Photos will stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Video wird aus dieser App entfernt. Dein Ergebnis und Kopien in Fotos bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {

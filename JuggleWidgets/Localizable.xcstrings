    "Your best streak, this week and your next goal. Tap to start juggling." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine beste Serie, diese Woche und dein nächstes Ziel. Tippen und loslegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mejor racha, esta semana y tu próxima meta. Toca para hacer toques."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta meilleure série, ta semaine et ton prochain objectif. Touche pour jongler."
